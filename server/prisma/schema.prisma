generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EquipmentTrackingMode {
  INDIVIDUAL
  QUANTITY
}

enum EquipmentStatus {
  DISPONIBLE
  ASIGNADO
  EN_CUSTODIA
  EN_REPARACION
  FUERA_DE_SERVICIO
  BAJA
}

enum EquipmentCategory {
  ARMAMENTO
  PROTECCION
  COMUNICACIONES
  MUNICION
  ACCESORIO
  OTRO
}

enum AssignmentType {
  PERMANENT
  TEMPORARY
}

enum AssignmentStatus {
  ACTIVE
  RETURNED
  CANCELLED
}

model Personnel {
  id Int @id @default(autoincrement())

  firstName String
  lastName  String

  dni        String @unique
  fileNumber String @unique

  rank      String
  bloodType String?

  phone String?
  email String?

  addressLegacy String? @map("address")

  addressStreet   String?
  addressDetail   String?
  addressCity     String?
  addressProvince String?

  status String @default("Activo")

  unit        String
  primaryArea String

  additionalAreas String[] @default([])

  dutyFunction String?
  observations String?

  assignments Assignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastName])
  @@index([status])
  @@index([rank])
  @@index([primaryArea])
  @@map("personnel")
}

model EquipmentType {
  id Int @id @default(autoincrement())

  name String @unique

  description String?

  isActive Boolean @default(true)

  category EquipmentCategory @default(OTRO)

  trackingMode EquipmentTrackingMode @default(INDIVIDUAL)

  defaultAssignmentType AssignmentType?

  equipment Equipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([isActive])
  @@index([category])
  @@index([trackingMode])
  @@index([defaultAssignmentType])
  @@map("equipment_types")
}

model Equipment {
  id Int @id @default(autoincrement())

  typeId Int
  type   EquipmentType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  inventoryNumber String? @unique
  serialNumber    String? @unique

  brand String?
  model String?

  status EquipmentStatus @default(DISPONIBLE)

  totalQuantity     Int @default(1)
  availableQuantity Int @default(1)

  observations String?

  assignmentDetails AssignmentDetail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([typeId])
  @@index([status])
  @@map("equipment")
}

model Assignment {
  id Int @id @default(autoincrement())

  personnelId Int
  personnel   Personnel @relation(fields: [personnelId], references: [id], onDelete: Restrict)

  type AssignmentType

  status AssignmentStatus @default(ACTIVE)

  assignedAt DateTime @default(now())

  returnedAt DateTime?

  observations String?

  details AssignmentDetail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personnelId])
  @@index([status])
  @@index([type])
  @@index([assignedAt])
  @@map("assignments")
}

model AssignmentDetail {
  id Int @id @default(autoincrement())

  assignmentId Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  equipmentId Int
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  quantity Int @default(1)

  returnedQuantity Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignmentId])
  @@index([equipmentId])
  @@map("assignment_details")
}

enum UserRole {
  ADMIN
}

model User {
  id Int @id @default(autoincrement())

  username     String @unique
  passwordHash String

  role UserRole @default(ADMIN)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([username])
  @@index([role])
  @@index([isActive])
  @@map("users")
}
